# 复制为 .env.local 后按需修改（.env.local 不会进版本库）
#
# VITE_API_BASE：后端根地址（不要带结尾斜杠，也不要带 /api/v1）
#   留空 / 不设置 —— 走同源相对路径：
#       · 开发期：由 vite.config.ts 的 proxy 把 /api 与 /static 转发到 http://127.0.0.1:8000
#       · 生产期：由 FastAPI 同时托管 dist/ 与 /api、/static，天然同源
#   设为完整地址 —— 前端独立部署（如 nginx / CDN）时直连后端：
#       VITE_API_BASE=http://192.168.1.10:8000
#
# 前端会把图片地址拼成  <VITE_API_BASE>/static/<crop_path>
VITE_API_BASE=

# Vite 开发服务器 proxy 的目标后端（仅 npm run dev 生效，不进入前端产物）
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
